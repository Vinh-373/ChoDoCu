# Địa chỉ BE (ChoDoCu.API) mà dev server sẽ chuyển tiếp request tới.
# Xem cổng thật trong: src/ChoDoCu.API/Properties/launchSettings.json  (dòng "applicationUrl")
VITE_PROXY_TARGET=https://localhost:7000

# Chỉ điền khi build để triển khai (FE và BE khác domain). Để trống khi chạy dev.
# Ví dụ: VITE_API_URL=https://api.chodocu.vn/api
VITE_API_URL=
